{
  "name": "chex",
  "description": "Task runner for the CHEX build. The crate version in Cargo.toml is the source of truth.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ./scripts/cargo.mjs build --release",
    "build:wasm": "bun ./scripts/build-wasm.mjs",
    "build:mobile": "bun ./scripts/build-mobile.mjs ios android",
    "test": "bun ./scripts/cargo.mjs test",
    "test:clients": "bun ./scripts/verify-clients.mjs",
    "lint": "bun ./scripts/cargo.mjs clippy --all-targets",
    "fmt": "bun ./scripts/cargo.mjs fmt",
    "scan:schemas": "bun ./scripts/cargo.mjs build --release && bun ./scripts/scan-schema-compat.mjs"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d31ma/CHEX.git"
  },
  "homepage": "https://github.com/d31ma/CHEX#readme",
  "bugs": {
    "url": "https://github.com/d31ma/CHEX/issues"
  },
  "license": "MIT",
  "keywords": [
    "rust",
    "wasm",
    "validation",
    "schema",
    "regex",
    "cli",
    "executable"
  ],
  "author": "Chidelma"
}
